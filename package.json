    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "22.19.2",
    "postcss": "8.5.27",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "~6.0.3"
